PORT=3000
HOST=0.0.0.0

# Storage mode:
# - auto: use MySQL/MariaDB when MYSQL_* config exists, otherwise local legacy mode
# - mysql: production database mode, fail startup if database is unavailable
# - excel: legacy local/testing mode only
POS_STORAGE=auto
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=pos_user
MYSQL_PASSWORD=change_this_password
MYSQL_DATABASE=pos_system
MYSQL_TABLE_PREFIX=pos_

# Backups
POS_BACKUP_DIR=backups
POS_BACKUP_INTERVAL_MINUTES=1440

# Legacy/testing only. Do not use Excel as production storage.
# POS_STORAGE=excel
# POS_ALLOW_EXCEL_FALLBACK=1
